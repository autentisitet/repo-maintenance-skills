# 默认把文本规范化为 LF；按项目需要覆盖特殊文件
* text=auto eol=lf

# 明确二进制，避免被当成文本做 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.onnx binary
*.pt binary
*.safetensors binary

# 不要在语言统计里刷屏
docs/** linguist-documentation
uv.lock linguist-generated
requirements.txt linguist-generated

# cmd.exe 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
